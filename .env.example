# Google Sheets + Apps Script backend (replaces Airtable).
# Copy this file to .env.local and fill in real values (never commit .env.local).
#
# Spreadsheet:
#   https://docs.google.com/spreadsheets/d/1MBLSA8jBLTscBl-fdP3p-ynOKimRJCXeyBycvHCGYio
#
# One-time setup: paste google-apps-script/quote-form.gs into script.google.com,
# Deploy as Web app (Anyone), then put the /exec URL below. Same vars in Netlify.

# Quote form + content + CRM — Apps Script web app URL (ends in /exec).
NEXT_PUBLIC_QUOTE_SCRIPT_URL=https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID/exec

# Server-side only — must match READ_TOKEN in quote-form.gs
SUBMISSIONS_READ_TOKEN=FsJ8rK2mP9xQ4nW7vL3sT6hY1bN5cD0e

# Optional override if the server proxy should hit a different URL than public.
# QUOTE_SCRIPT_URL=https://script.google.com/macros/s/…/exec

# Spreadsheet ID (reference; also hard-coded in quote-form.gs)
GOOGLE_SHEET_ID=1MBLSA8jBLTscBl-fdP3p-ynOKimRJCXeyBycvHCGYio
